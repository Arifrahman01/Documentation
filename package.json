{
  "name": "documentation-portal",
  "version": "1.0.0",
  "description": "Portal Dokumentasi Teknis, Arsitektur Sistem, dan Program Navigator Enterprise berbasis SvelteKit & Shadcn UI dengan integrasi AI Copilot",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "$lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite dev --port 8088",
    "build": "vite build",
    "preview": "vite preview --port 8088",
    "start": "node build/index.js",
    "server": "node server.cjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "index": "node generate-index.cjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "fuse.js": "^7.5.0",
    "marked": "^18.1.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  }
}
