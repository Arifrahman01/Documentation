# Server & Deployment Configuration
PORT=5008
HOST=0.0.0.0
ORIGIN=https://demo2.jhonlingroup.id
ALLOWED_ORIGINS=https://demo2.jhonlingroup.id,http://demo2.jhonlingroup.id,http://localhost:5008,http://localhost:8088,http://127.0.0.1:5008,http://127.0.0.1:8088

# AI Copilot Configuration
AI_HOST=127.0.0.1
AI_PORT=8045
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-3.8-flash-low
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_ALLOWED_MODELS=gemini-3.8-flash-low,gemini-3.8-flash,gemini-3.8-flash-medium,gemini-2.5-flash,gemini-2.5-pro
AI_TIMEOUT_MS=60000

# Security & Session Configuration
# WAJIB di production: harus SAMA PERSIS dengan SESSION_SECRET di Helpdesk (cookie user_sig = HMAC-SHA256(user_name, secret)).
# Jika kosong, cookie user_name TIDAK diverifikasi dan bisa dipalsukan. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DEV_FALLBACK_USER=Arif Rahman

# External Documents Directory (RAG Knowledge Source)
# Ubah path ini sesuai letak folder dokumen di server (misal: /var/www/helpdesk2/storage/app/private atau D:\...)
EXTERNAL_DOCS_DIR=""

# Database Configuration for AI Realtime Query (Metode 2)
# WAJIB di production: JANGAN gunakan akun root. Buat user khusus yang hanya boleh SELECT
# pada tabel yang dibutuhkan AI, contoh (jalankan sebagai admin MySQL):
#   CREATE USER 'docs_ai_ro'@'127.0.0.1' IDENTIFIED BY '<password-kuat>';
#   GRANT SELECT ON helpdesk.tickets        TO 'docs_ai_ro'@'127.0.0.1';
#   GRANT SELECT ON helpdesk.modules        TO 'docs_ai_ro'@'127.0.0.1';
#   GRANT SELECT ON helpdesk.module_ticket  TO 'docs_ai_ro'@'127.0.0.1';
#   GRANT SELECT ON helpdesk.companies      TO 'docs_ai_ro'@'127.0.0.1';
#   GRANT SELECT ON helpdesk.company_ticket TO 'docs_ai_ro'@'127.0.0.1';
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=docs_ai_ro
DB_PASSWORD=


