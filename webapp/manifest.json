{
  "_version": "1.58.0",
  "sap.app": {
    "id": "doc.portal",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "SAPUI5 SDK — Demo Kit",
    "description": "SAPUI5 SDK Demo Kit Style Documentation Portal",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "doc.portal.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": false
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "doc.portal.i18n.i18n",
          "supportedLocales": ["", "id", "en"],
          "fallbackLocale": ""
        }
      },
      "apps": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/apps.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "doc.portal.view",
        "controlId": "pageContainer",
        "controlAggregation": "pages",
        "transition": "fade",
        "bypassed": {
          "target": "home"
        },
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "home",
          "target": "home"
        },
        {
          "pattern": "home",
          "name": "homeDirect",
          "target": "home"
        },
        {
          "pattern": "topic",
          "name": "topicRoot",
          "target": "topic"
        },
        {
          "pattern": "topic/:path*:",
          "name": "topic",
          "target": "topic"
        },
        {
          "pattern": "apps",
          "name": "apps",
          "target": "apps"
        },
        {
          "pattern": "demoapps",
          "name": "demoapps",
          "target": "apps"
        },
        {
          "pattern": "resources",
          "name": "resources",
          "target": "resources"
        }
      ],
      "targets": {
        "home": {
          "viewName": "Home",
          "viewLevel": 1,
          "id": "home"
        },
        "topic": {
          "viewName": "Topic",
          "viewLevel": 2,
          "id": "topic"
        },
        "apps": {
          "viewName": "Apps",
          "viewLevel": 1,
          "id": "apps"
        },
        "demoapps": {
          "viewName": "Apps",
          "viewLevel": 1
        },
        "resources": {
          "viewName": "Resources",
          "viewLevel": 1,
          "id": "resources"
        }
      }
    }
  }
}
