<mvc:View
  controllerName="doc.portal.controller.Resources"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout">

  <Page
    id="resourcesPage"
    showHeader="false"
    class="sdkResourcesPage">

    <content>
      <VBox class="sdkResourcesWrapper">

        <!-- Header Hero -->
        <VBox class="sdkResourcesHero">
          <Title text="Developer Resources &amp; Tooling" level="H1" titleStyle="H1" class="sdkResourcesHeroTitle" />
          <Text text="Alat bantu pengembang, panduan arsitektur SAPUI5, pintasan papan ketik, dan tautan dokumentasi resmi." class="sdkResourcesHeroSubtitle" />
        </VBox>

        <!-- Main Content -->
        <VBox class="sdkResourcesContent">
          <l:Grid defaultSpan="XL6 L6 M12 S12" class="sdkResourcesGrid">

            <!-- Card 1: Developer CLI & Environment -->
            <VBox class="sdkResourceCard">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://developer-settings" class="sdkResourceIcon sdkIconPurple" />
                <VBox class="sapUiSmallMarginBegin">
                  <Title text="Development Commands &amp; CLI" level="H3" class="sdkResourceTitle" />
                  <Text text="Perintah build &amp; server lokal" class="sdkResourceSubtitle" />
                </VBox>
              </HBox>
              <Text text="Portal ini dibangun menggunakan pustaka OpenUI5 dengan build task mandiri dan server Express lokal." class="sdkResourceDesc" />
              
              <VBox class="sapUiSmallMarginTop sdkCodeSnippetBox">
                <Text text="# Jalankan server lokal di port 8088:" class="sdkTerminalComment" />
                <Text text="npm start" class="sdkTerminalCommand" />
                <Text text="# Build bundel produksi (minifikasi &amp; preload):" class="sdkTerminalComment sapUiTinyMarginTop" />
                <Text text="npm run build" class="sdkTerminalCommand" />
              </VBox>
            </VBox>

            <!-- Card 2: Keyboard Shortcuts -->
            <VBox class="sdkResourceCard">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://keyboard-and-mouse" class="sdkResourceIcon sdkIconBlue" />
                <VBox class="sapUiSmallMarginBegin">
                  <Title text="Pintasan Papan Ketik (Shortcuts)" level="H3" class="sdkResourceTitle" />
                  <Text text="Akses cepat navigasi &amp; pencarian" class="sdkResourceSubtitle" />
                </VBox>
              </HBox>
              
              <VBox class="sdkShortcutsList">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Buka Pencarian Global" />
                  <Text text="Ctrl + K" class="sdkShortcutBadge" />
                </HBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Toggle Navigasi Sidebar" />
                  <Text text="Tombol Menu ☰" class="sdkShortcutBadge" />
                </HBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Salin Snippet Kode" />
                  <Text text="Tombol Copy 📋" class="sdkShortcutBadge" />
                </HBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Ganti Tema Terang / Gelap" />
                  <Text text="Ikon Tema 🌓" class="sdkShortcutBadge" />
                </HBox>
              </VBox>
            </VBox>

            <!-- Card 3: External Official Links -->
            <VBox class="sdkResourceCard">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://chain-link" class="sdkResourceIcon sdkIconGreen" />
                <VBox class="sapUiSmallMarginBegin">
                  <Title text="Dokumentasi &amp; SDK Resmi" level="H3" class="sdkResourceTitle" />
                  <Text text="Referensi standar SAP Global" class="sdkResourceSubtitle" />
                </VBox>
              </HBox>
              
              <List mode="None" class="sdkResourceLinksList">
                <StandardListItem
                  title="SAPUI5 Official Demo Kit"
                  description="https://ui5.sap.com"
                  icon="sap-icon://open-command-execution"
                  type="Navigation"
                  press=".onOpenExternal('https://ui5.sap.com')" />
                <StandardListItem
                  title="SAP Fiori Design Guidelines"
                  description="Panduan desain resmi SAP Horizon &amp; Fiori"
                  icon="sap-icon://palette"
                  type="Navigation"
                  press=".onOpenExternal('https://experience.sap.com/fiori-design/')" />
                <StandardListItem
                  title="SAP Help Portal"
                  description="Dokumentasi produk resmi SAP S/4HANA &amp; SAC"
                  icon="sap-icon://learning-assistant"
                  type="Navigation"
                  press=".onOpenExternal('https://help.sap.com')" />
                <StandardListItem
                  title="SAP Community"
                  description="Diskusi teknis ABAP RAP, CDS Views, dan Fiori"
                  icon="sap-icon://group"
                  type="Navigation"
                  press=".onOpenExternal('https://community.sap.com')" />
              </List>
            </VBox>

            <!-- Card 4: Architecture & Version Info -->
            <VBox class="sdkResourceCard">
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <core:Icon src="sap-icon://sys-monitor" class="sdkResourceIcon sdkIconOrange" />
                <VBox class="sapUiSmallMarginBegin">
                  <Title text="Arsitektur Portal Dokumentasi" level="H3" class="sdkResourceTitle" />
                  <Text text="Komponen &amp; pustaka aktif" class="sdkResourceSubtitle" />
                </VBox>
              </HBox>
              
              <VBox class="sdkShortcutsList">
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Frontend Framework" />
                  <Text text="OpenUI5 1.120 (SAP Horizon)" class="sdkVersionPill" />
                </HBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Markdown Parser" />
                  <Text text="markdown-it 14.1 + Anchor" class="sdkVersionPill" />
                </HBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Syntax Highlighter" />
                  <Text text="PrismJS (ABAP, JS, HTML, Bash)" class="sdkVersionPill" />
                </HBox>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sdkShortcutRow">
                  <Text text="Local Server" />
                  <Text text="Node.js Express (Port 8088)" class="sdkVersionPill" />
                </HBox>
              </VBox>
            </VBox>

          </l:Grid>
        </VBox>

      </VBox>
    </content>
  </Page>

</mvc:View>
