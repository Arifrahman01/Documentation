<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="aiCopilotDialog"
    showHeader="false"
    contentWidth="680px"
    class="sdkAiDialog">

    <content>
      <VBox>
        <!-- Header Toolbar -->
        <Toolbar class="sdkAiHeaderBar">
          <core:Icon src="sap-icon://learning-assistant" size="1.2rem" color="#38bdf8" />
          <Title text="AI Copilot" level="H3" class="sapUiTinyMarginBegin" />
          <ObjectStatus text="● Gemini 3.8 Flash Medium (Online)" state="Success" class="sdkAiOnlineBadge sapUiSmallMarginBegin" />
          <ToolbarSpacer />
          <Button
            icon="sap-icon://delete"
            tooltip="Bersihkan Riwayat Percakapan"
            type="Transparent"
            press=".onClearAiChat"
            class="sdkAiHeaderToolBtn" />
          <Button
            icon="sap-icon://decline"
            tooltip="Tutup AI Copilot"
            type="Transparent"
            press=".onCloseAiDialog"
            class="sdkAiHeaderToolBtn" />
        </Toolbar>

        <!-- Context Indicator Bar -->
        <HBox alignItems="Center" class="sdkAiContextBar">
          <Text id="aiContextText" text="🏢 Konteks: Portal Dokumentasi &amp; Program Navigator" />
        </HBox>

        <!-- Chat Messages Scroll Container -->
        <ScrollContainer
          id="aiChatScroll"
          height="380px"
          vertical="true"
          horizontal="false"
          class="sdkAiChatScroll">
          <VBox id="aiMessagesBox" class="sdkAiMessagesBox" />
        </ScrollContainer>

        <!-- Dynamic Quick Prompt Chips Bar -->
        <HBox id="aiPromptChipsBar" wrap="Wrap" class="sdkAiPromptChips" />

        <!-- Chat Input Bar -->
        <HBox alignItems="Center" width="100%" class="sdkAiInputBar">
          <Input
            id="aiInput"
            placeholder="Tanya AI Copilot tentang sistem atau dokumentasi... (Enter untuk kirim)"
            width="100%"
            submit=".onSendAiQuestionFromInput"
            class="sdkAiInput" />
          <Button
            id="btnAiSend"
            icon="sap-icon://paper-plane"
            type="Emphasized"
            tooltip="Kirim Pertanyaan"
            press=".onSendAiQuestionFromButton"
            class="sdkAiSendBtn" />
        </HBox>
      </VBox>
    </content>

  </Dialog>

</core:FragmentDefinition>
