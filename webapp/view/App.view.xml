<mvc:View
  controllerName="doc.portal.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  height="100%">

  <VBox height="100%" fitContainer="true" class="sdkAppRoot">

    <!-- ====== TOP BAR ROW 1: SHELL BAR (ui5.sap.com STYLE) ====== -->
    <HBox class="sdkTopShellBar" alignItems="Center" justifyContent="SpaceBetween">

      <!-- Left: Toggle + Logo + Title + Version -->
      <HBox alignItems="Center" class="sdkTopShellLeft">
        <!-- Hamburger menu toggle button -->
        <Button
          id="btnToggleSideNav"
          icon="sap-icon://menu2"
          type="Transparent"
          press=".onToggleSideNav"
          tooltip="Toggle Navigation"
          class="sdkHeaderIconBtn" />

        <!-- Jhonlin Group Brand Emblem & Title -->
        <HBox alignItems="Center" class="sdkBrandWrapper">
          <Image src="img/jhonlin_emblem.png" width="30px" height="30px" class="sdkJhonlinLogoImg" press=".onNavHome" />
          <Link text="PT JHONLIN GROUP" class="sdkBrandTitle" press=".onNavHome" />
          <ObjectStatus text="DOCS" state="Information" inverted="true" class="sdkBrandDocsPill sapUiTinyMarginBegin" />
        </HBox>

        <!-- Version / Division Selector Pill Button -->
        <Button
          text="Portal v2025"
          icon="sap-icon://sys-enter-2"
          type="Transparent"
          class="sdkVersionPillBtn"
          press=".onShowVersionDialog" />
      </HBox>

      <!-- Center: Wide "Search Anything" Field -->
      <HBox alignItems="Center" class="sdkTopShellCenter">
        <SearchField
          id="globalSearchField"
          placeholder="Cari dokumentasi, aplikasi &amp; sistem Jhonlin..."
          width="480px"
          search=".onGlobalSearch"
          class="sdkSearchAnythingField" />
      </HBox>

      <!-- Right: Action Icons (AI Copilot, Notifications, Feedback, Legal, Settings) -->
      <HBox alignItems="Center" class="sdkTopShellRight">
        <Button
          id="btnTopAiCopilot"
          icon="sap-icon://learning-assistant"
          text="AI Copilot"
          type="Emphasized"
          tooltip="Jhonlin AI Copilot (Claude Sonnet)"
          class="sdkAiCopilotBtn sapUiTinyMarginEnd"
          press=".onOpenAiCopilot" />

        <Button
          icon="sap-icon://bell"
          type="Transparent"
          tooltip="Notifications"
          class="sdkHeaderIconBtn sdkNotificationBtn"
          press=".onHeaderAction">
          <customData>
            <core:CustomData key="badge" value="3" writeToDom="true" />
          </customData>
        </Button>

        <Button
          icon="sap-icon://feedback"
          type="Transparent"
          tooltip="Feedback"
          class="sdkHeaderIconBtn"
          press=".onHeaderAction" />

        <Button
          icon="sap-icon://official-service"
          type="Transparent"
          tooltip="Legal &amp; Compliance"
          class="sdkHeaderIconBtn"
          press=".onHeaderAction" />

        <Button
          id="themeToggleButton"
          icon="{= ${appView>/selectedTheme} === 'sap_horizon_dark' ? 'sap-icon://light-mode' : 'sap-icon://action-settings'}"
          type="Transparent"
          tooltip="Settings &amp; Theme"
          class="sdkHeaderIconBtn"
          press=".onToggleTheme" />
      </HBox>

    </HBox>

    <!-- ====== TOP BAR ROW 2: NAVIGATION TABS BAR (ui5.sap.com STYLE) ====== -->
    <HBox class="sdkNavBar" alignItems="Center">
      <Button
        id="navTabHome"
        text="Home"
        icon="sap-icon://home"
        type="Transparent"
        class="sdkNavTab"
        press=".onNavHome" />

      <Button
        id="navTabDocumentation"
        text="Documentation"
        icon="sap-icon://course-book"
        type="Transparent"
        class="sdkNavTab"
        press=".onNavDocumentation" />

      <Button
        id="navTabApi"
        text="API Reference"
        icon="sap-icon://syntax"
        type="Transparent"
        class="sdkNavTab"
        press=".onNavApiReference" />

      <Button
        id="navTabApps"
        text="Apps"
        icon="sap-icon://grid"
        type="Transparent"
        class="sdkNavTab"
        press=".onNavApps" />

      <Button
        id="navTabResources"
        text="Resources"
        icon="sap-icon://wrench"
        type="Transparent"
        class="sdkNavTab"
        press=".onNavResources" />
    </HBox>

    <!-- ====== MAIN NAV CONTAINER ====== -->
    <NavContainer id="pageContainer" autoFocus="false" class="sdkPageContainer">
      <layoutData>
        <FlexItemData growFactor="1" baseSize="0" />
      </layoutData>
    </NavContainer>

    <!-- ====== FLOATING AI COPILOT BUTTON ====== -->
    <Button
      id="btnFloatingAi"
      icon="sap-icon://learning-assistant"
      text="Tanya AI"
      type="Emphasized"
      tooltip="Buka Jhonlin AI Copilot"
      class="sdkFloatingAiBtn"
      press=".onOpenAiCopilot" />

  </VBox>

</mvc:View>
