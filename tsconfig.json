{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "$app/types"]
	},
	"include": [
		"src",
		"*"
	],
	"exclude": [
		"src/service-worker"
	]
}
