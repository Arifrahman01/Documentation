{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "$app/types"],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts"
	],
	"exclude": [
		"src/service-worker.ts",
		"src/service-worker/**/*"
	]
}
